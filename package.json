{
  "name": "mediew",
  "version": "1.0.0",
  "description": "Media Browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:zip": "electron-builder --win zip",
    "build:nsis": "electron-builder --win nsis",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "exiftool-vendored": "^39.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mediew.app",
    "productName": "Mediew",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json",
      "build/icon.ico",
      "services/**/*"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/exiftool-vendored.exe/**/*",
      "node_modules/exiftool-vendored.pl/**/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "MIT"
}
